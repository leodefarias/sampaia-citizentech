[Unit]
Description=SampaIA - API de Lembretes
After=network-online.target
Wants=network-online.target

[Service]
User=sampaia
WorkingDirectory=/opt/sampaia/dados
EnvironmentFile=/etc/sampaia/sampaia.env
Environment=ASPNETCORE_URLS=http://0.0.0.0:5010
ExecStart=/usr/bin/dotnet /opt/sampaia/lembretes/Lembretes.Api.dll
Restart=always
RestartSec=3
# Segurança básica do processo
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sampaia/dados
PrivateTmp=true

[Install]
WantedBy=multi-user.target
