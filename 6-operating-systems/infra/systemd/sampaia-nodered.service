[Unit]
Description=SampaIA - Node-RED (ponte MQTT entre o ESP32 e a API de Lembretes)
After=network-online.target sampaia-lembretes.service
Wants=network-online.target

[Service]
User=sampaia
WorkingDirectory=/opt/sampaia/node-red
# MQTT_BROKER, MQTT_PORTA, SAMPAIA_DISPOSITIVO e LEMBRETES_URL vêm daqui.
EnvironmentFile=/etc/sampaia/sampaia.env
ExecStart=/opt/sampaia/node-red/node_modules/.bin/node-red --userDir /opt/sampaia/node-red --settings /opt/sampaia/node-red/settings.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sampaia/node-red
PrivateTmp=true

[Install]
WantedBy=multi-user.target
